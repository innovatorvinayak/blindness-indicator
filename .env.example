# Copy to .env and fill in. Never commit .env.

# --- Model -------------------------------------------------------------------
DRS_MODEL_PATH=models/classifier.pt
DRS_DEVICE=auto                 # auto | cpu | cuda | mps
DRS_TTA=true                    # average with horizontal flip (more stable, 2x compute)
DRS_REFERRAL_THRESHOLD=0.5      # P(grade >= Moderate) to flag referral; lower = fewer missed cases

# --- Database ----------------------------------------------------------------
# SQLite (default, zero setup):
# DRS_DATABASE_URL=sqlite:///data/drscreen.db
# MySQL / MariaDB (HeidiSQL):
# DRS_DATABASE_URL=mysql+pymysql://drscreen:change-me@localhost:3306/drscreen?charset=utf8mb4
DRS_IMAGE_STORE=data/images
DRS_REPORT_DIR=data/reports

# --- SMS ------------------------------------------------------------------------
# Twilio is tried first if configured; otherwise Fast2SMS; otherwise dry-run
# (the message is printed to the log instead of sent). All of this can also be
# edited from inside the app: Settings page.
DRS_SMS_ENABLED=true
DRS_DEFAULT_COUNTRY_CODE=+91
DRS_CLINIC_NAME=DR Screening Centre

# Twilio: https://www.twilio.com — free trial credit, but SMS can only go to
# numbers you've verified in the console until you add a paid plan.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # e.g. +12025550123 (or use a messaging service below)
TWILIO_MESSAGING_SERVICE_SID=

# Fast2SMS (India): https://www.fast2sms.com — free sign-up, no card required.
# The "Quick SMS" route (the default below) needs no DLT template approval and
# gives a small free daily quota, enough to try this project end to end with
# real text messages to real Indian numbers.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q

# --- Chat assistant (Ollama) ------------------------------------------------
# Explains a screening result in plain language; scoped to that one result
# only (see drscreen/chat.py). Needs a separate Ollama process running
# (`ollama serve`) with the model pulled (`ollama pull llama3.2:3b`) — the
# chat widget just disappears if it isn't reachable, nothing else breaks.
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Web app -----------------------------------------------------------------
# Signs session cookies. Auto-generated if left blank, which is fine for
# local use (every restart forces re-login) — set this explicitly for any
# real deployment so sessions survive a restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DRS_SECRET_KEY=
